{
  "_version": "1.89.0",
  "sap.app": {
    "id": "order.conf.orderassistant",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "dataSources": {
      "orderAssistant": {
        "uri": "a2a/order-assistant/",
        "type": "JSON"
      }
    },
    "crossNavigation": {
      "inbounds": {
        "OrderAssistant-ask": {
          "semanticObject": "OrderAssistant",
          "action": "ask",
          "title": "{{appTitle}}",
          "subTitle": "{{flpSubtitle}}",
          "icon": "sap-icon://discussion-2",
          "signature": {
            "parameters": {
              "caseId": {
                "required": false
              },
              "crId": {
                "required": false
              },
              "source": {
                "required": false
              }
            },
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "sap-icon://discussion-2",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": false,
    "rootView": {
      "viewName": "order.conf.orderassistant.view.App",
      "type": "XML",
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.152.0",
      "libs": {
        "sap.m": {},
        "sap.f": {},
        "sap.ui.core": {},
        "sap.ui.layout": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "order.conf.orderassistant.i18n.i18n"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ]
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  }
}
