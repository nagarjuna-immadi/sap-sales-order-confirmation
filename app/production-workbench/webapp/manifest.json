{
  "_version": "1.89.0",
  "sap.app": {
    "id": "order.conf.productionworkbench",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.33.0",
      "toolsId": "8c2e4a61-3b7d-4f09-a5e2-6d1b9f3c7a40"
    },
    "dataSources": {
      "mainService": {
        "uri": "odata/v4/production/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "odataVersion": "4.0"
        }
      },
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "CapacityRequest-decide": {
          "semanticObject": "CapacityRequest",
          "action": "decide",
          "title": "{{appTitle}}",
          "subTitle": "{{flpSubtitle}}",
          "icon": "sap-icon://factory",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.152.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.viz": {
          "lazy": true
        }
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "order.conf.productionworkbench.i18n.i18n"
        }
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {},
      "routes": [
        {
          "pattern": ":?query:",
          "name": "CapacityRequestsList",
          "target": "CapacityRequestsList"
        },
        {
          "pattern": "CapacityRequests({key}):?query:",
          "name": "CapacityRequestsObjectPage",
          "target": "CapacityRequestsObjectPage"
        }
      ],
      "targets": {
        "CapacityRequestsList": {
          "type": "Component",
          "id": "CapacityRequestsList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/CapacityRequests",
              "variantManagement": "Page",
              "navigation": {
                "CapacityRequests": {
                  "detail": {
                    "route": "CapacityRequestsObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  },
                  "actions": {
                    "notifications": {
                      "press": "order.conf.productionworkbench.ext.controller.CaseActions.openNotifications",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "{i18n>notifications}"
                    }
                  }
                }
              },
              "initialLoad": "Enabled"
            }
          }
        },
        "CapacityRequestsObjectPage": {
          "type": "Component",
          "id": "CapacityRequestsObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "editableHeaderContent": false,
              "contextPath": "/CapacityRequests",
              "content": {
                "header": {
                  "actions": {
                    "notifications": {
                      "press": "order.conf.productionworkbench.ext.controller.CaseActions.openNotifications",
                      "visible": true,
                      "enabled": true,
                      "text": "{i18n>notifications}"
                    },
                    "askAboutCase": {
                      "press": "order.conf.productionworkbench.ext.controller.CaseActions.askAboutCase",
                      "visible": true,
                      "enabled": true,
                      "text": "{i18n>askAboutCase}"
                    }
                  }
                },
                "body": {
                  "sections": {
                    "LoadBeforeAfter": {
                      "template": "order.conf.productionworkbench.ext.fragment.LoadChart",
                      "title": "{i18n>loadSection}",
                      "position": {
                        "placement": "After",
                        "anchor": "Options"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ObjectPage.ObjectPageController#order.conf.productionworkbench::CapacityRequestsObjectPage": {
            "controllerName": "order.conf.productionworkbench.ext.controller.LoadChart"
          }
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
